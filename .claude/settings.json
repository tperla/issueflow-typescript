{
  "hooks": {
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python -c \"import sys,json,datetime; d=json.load(sys.stdin); open('.claude/logs/prompts-raw.md','a').write('## Prompt\\n'+datetime.datetime.utcnow().isoformat()+'Z\\nModel: claude-sonnet-4-6\\n\\n'+d.get('prompt','')+' \\n---\\n')\""
          }
        ]
      }
    ]
  }
}
