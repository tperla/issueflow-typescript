        {
          "name": "Export Tickets to CSV",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/tickets/export?projectId={{projectId}}",
              "host": ["{{baseUrl}}"],
              "path": ["tickets", "export"],
              "query": [{ "key": "projectId", "value": "{{projectId}}" }]
            }
          }
        },
        {
          "name": "Import Tickets from CSV",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": "",
                  "description": "CSV file with columns: title,description,status,priority,type,assigneeId"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/tickets/import?projectId={{projectId}}",
