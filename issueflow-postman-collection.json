        {
          "name": "Restore Ticket (ADMIN only)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/tickets/{{ticketId}}/restore",
              "host": ["{{baseUrl}}"],
              "path": ["tickets", "{{ticketId}}", "restore"]
            }
